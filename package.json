{
  "name": "ai-content-generator-api",
  "version": "0.1.0",
  "private": true,
  "description": "AI Content Generator API — geração assíncrona de conteúdo com Fastify, BullMQ e S3.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.11.0"
  },
  "scripts": {
    "dev:api": "tsx watch src/main.ts",
    "build": "npm run prisma:generate && tsc -p tsconfig.build.json",
    "start:api": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:status": "prisma migrate status",
    "prisma:seed": "prisma db seed",
    "validate": "npm run prisma:generate && npm run prisma:validate && npm run typecheck && npm run lint && npm run format:check && npm run build"
  },
  "dependencies": {
    "@fastify/swagger": "9.8.1",
    "@prisma/adapter-pg": "7.9.0",
    "@prisma/client": "7.9.0",
    "fastify": "5.10.0",
    "fastify-type-provider-zod": "7.0.0",
    "openapi-types": "12.1.3",
    "pino": "10.3.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.1",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "pino-pretty": "13.1.3",
    "prettier": "3.9.6",
    "prisma": "7.9.0",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0"
  }
}
