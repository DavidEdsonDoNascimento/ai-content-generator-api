{
  // Config de referência: cobre TUDO que é TypeScript no repositório (aplicação,
  // seed e configuração da CLI do Prisma). É a que o editor e o ESLint com
  // tipagem usam. A emissão de `dist/` fica em `tsconfig.build.json`, que
  // restringe o escopo a `src/`.
  "compilerOptions": {
    /* Ambiente: Node.js 22 LTS, ESM nativo ("type": "module" no package.json). */
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],

    "noEmit": true,

    /* Tipagem estrita (exigência do enunciado) */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,

    /* Interoperabilidade e consistência */
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.ts",
    "prisma/**/*.ts",
    "test/**/*.ts",
    "prisma.config.ts",
    "vitest.config.ts",
    "vitest.e2e.config.ts"
  ]
}
