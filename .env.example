# Copie este arquivo para `.env` antes de rodar a API localmente:
#   cp .env.example .env
# O `.env` real nunca é versionado (ver .gitignore).

# Ambiente de execução. Obrigatória — sem valor padrão, para que o ambiente
# seja sempre uma escolha explícita. Valores: development | test | production
NODE_ENV=development

# Interface de escuta do servidor HTTP. Padrão: 0.0.0.0
HOST=0.0.0.0

# Porta do servidor HTTP. Padrão: 3000
PORT=3000

# Nível de log do pino. Padrão: info
# Valores: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# As variáveis de PostgreSQL (DATABASE_URL), Redis (REDIS_URL), Minio/S3 (S3_*)
# e do simulador de IA (AI_DELAY_MS, AI_FAILURE_RATE, JOB_ATTEMPTS) serão
# adicionadas nas fases em que essas integrações forem implementadas
# (ver docs/0003_Implementation_Plan.md). Declará-las agora obrigaria a
# preencher valores que nenhum código lê.
# ---------------------------------------------------------------------------
